# Source allowlist: keep games, generated projects, logs and signing files out.
*
!/.gitignore
!/.gitattributes
!/README.md
!/README_EN.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/build.py
!/requirements.txt
!/scripts/
!/scripts/*.py
!/scripts/*.rb
!/src/
/src/*
!/src/runtime/
!/src/runtime/*.cs
!/src/runtime/*.mm
!/src/runtime/*.h
!/src/launch/
!/src/launch/strings.json
!/tests/
!/tests/*.py
!/tests/*.cs
!/tests/*.cpp
!/docs/
!/docs/*.md
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug_report.md
**/__pycache__/
*.pyc
